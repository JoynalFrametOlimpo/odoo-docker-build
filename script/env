#!/bin/bash

# Generate environment file
## .ENV

      ( echo "# Odoo Parameters" ; \
        echo ODOO_IMAGE=odoo ; \
        echo ODOO_VERSION=19.0 ; \
        echo ODOO_PROXY_MODE=true ;  \
        echo ODOO_ADMIN_PASS=$(openssl rand -base64 32) ; \
        echo "" ; \
        echo "# Odoo.conf" ; \
        echo CONF_LOCAL_PATH=./odoo/19/conf ; \
        echo CONF_CONTAINER_PATH=/etc/odoo ; \
        echo "" ; \
        echo "# Customs Adddons" ; \
        echo EXTRA_ADDONS_LOCAL_PATH=./odoo/19/extra-addons ; \
        echo EXTRA_ADDONS_CONTAINER_PATH=/mnt/extra-addons ; \
        echo "" ; \
        echo "# Odoo Filestore session" ; \
        echo ODOO_FILESTORE_CONTAINER_PATH=/var/lib/odoo ; \
        echo "" ; \
        echo "# Postgres Parameters" ; \
        echo DB_IMAGE=postgres ; \
        echo DB_VERSION=18-alpine; \
        echo DB_NAME=odoo ; \
        echo DB_USER=odoo ; \
        echo DB_filter=.* ; \
        echo DB_CONTAINER_PATH=/var/lib/postgresql/data ; \
        echo DB_PASSWORD=$(openssl rand -base64 32) ) >> ./.env
