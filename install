#!/bin/bash
# Config and Install Odoo Server 19.0
# Author: Joynal Framet Olimpo - December 2025
# Support only for Ubuntu

set -e  # Exit on error

ODOO_PATH="./odoo"
ODOO_VERSION="19.0"

# Function to print colored output
print_info() {
    echo -e "\033[34m***************** $1 ********************\033[0m"
}

# Upgrade && Update (optional, comment out if not needed)
# apt upgrade -y && apt update -y

# Set local datetime
if [ -L /etc/localtime ]; then
    ln -sf /usr/share/zoneinfo/America/Guayaquil /etc/localtime
fi

dt=$(date '+%d-%m-%Y--%H-%M-%S')

# Create backup environment directory
if [ ! -d ./backup-environment ]; then
    mkdir ./backup-environment
fi

# Make Backup folder for security reason
if [ -d ./odoo ]; then
    print_info "There is an installation in current directory, copying to backup folder for security"
    mv ./odoo "./backup-environment/odoo.$dt"
    rm -rf "$ODOO_PATH"
fi

if [ -e "./.env" ]; then
    mv ./.env "./backup-environment/odoo.$dt/"
fi

# Install Docker and Docker Compose
. /etc/os-release
SO=$ID

echo "$SO"

if [ "$SO" = "ubuntu" ]; then
    apt-get update -y
    apt-get install -y ca-certificates curl gnupg lsb-release make

    # Remove old docker-compose if installed
    apt-get remove -y docker-compose || true

    # Install Docker using official repo
    if ! command -v docker &> /dev/null; then
        print_info "Installing Docker"
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
        apt-get update -y
        apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
        groupadd docker || true
        usermod -aG docker "$USER"
    fi

    # Ensure Docker Compose plugin is installed
    if ! docker compose version &> /dev/null; then
        apt-get install -y docker-compose-plugin
    fi
fi

if [ ! -d "$ODOO_PATH/19" ]; then
    mkdir -p "$ODOO_PATH/19"
fi

# Generate odoo configuration file in new project
if [ ! -f "$ODOO_PATH/19/conf/odoo.conf" ]; then
    print_info "Creating odoo.conf inside project path"
    mkdir -p "$ODOO_PATH/19/conf/"
    print_info "Building odoo.conf"
    bash ./script/conf
fi

# Building Odoo Image
print_info "Building odoo image odoo:19.0"
make build

# Generate environment file
print_info "Building env"
bash ./script/env

chmod +x ./entrypoint.sh ./wait-for-psql.py
chmod -R 755 "$ODOO_PATH/19/"

print_info "Up services"
make compose

chown -R "$USER" "$ODOO_PATH/19/"
make logs

